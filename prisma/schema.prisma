generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  MANAGER
  SUPPORT
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  IN_REVIEW
  NEED_MORE_INFO
  WAITING_FOR_PART
  TECHNICIAN_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  REJECTED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  EXPIRING_SOON
}

enum NotificationType {
  STATUS_CHANGE
  ASSIGNMENT
  MESSAGE
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile   CustomerProfile?
  technicianProfile TechnicianProfile?
  assignedRequests  ServiceRequest[]       @relation("AssignedTechnician")
  statusChanges     RequestStatusHistory[]
  serviceReports    ServiceReport[]
  attachments       Attachment[]
  messages          Message[]
  notifications     Notification[]
}

model CustomerProfile {
  id                    String  @id @default(cuid())
  userId                String  @unique
  clinicName            String
  clinicAddress         String?
  nationalCodeOrCompanyId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]
  requests ServiceRequest[]
}

model TechnicianProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  specialty    String?
  serviceArea  String?
  isAvailable  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id               String         @id @default(cuid())
  customerId       String
  model            String
  serialNumber     String         @unique
  branch           String?
  purchaseDate     DateTime?
  installationDate DateTime?
  warrantyStartDate DateTime?
  warrantyEndDate  DateTime?
  warrantyStatus   WarrantyStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]
}

model ServiceRequest {
  id                   String          @id @default(cuid())
  trackingCode         String          @unique
  customerId           String
  deviceId             String
  assignedTechnicianId String?
  title                String
  customerName         String?
  phoneNumber          String?
  clinicAddress        String?
  problemDescription   String
  priority             RequestPriority @default(MEDIUM)
  status               RequestStatus   @default(NEW)
  slaDueAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  customer           CustomerProfile        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device             Device                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  assignedTechnician User?                  @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  statusHistory      RequestStatusHistory[]
  serviceReports     ServiceReport[]
  attachments        Attachment[]
  messages           Message[]
  notifications      Notification[]
}

model RequestStatusHistory {
  id          String         @id @default(cuid())
  requestId   String
  changedById String
  oldStatus   RequestStatus?
  newStatus   RequestStatus
  note        String?
  createdAt   DateTime       @default(now())

  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User           @relation(fields: [changedById], references: [id])
}

model ServiceReport {
  id             String        @id @default(cuid())
  requestId      String
  technicianId   String
  actionsDone    String
  technicalNotes String?
  finalStatus    RequestStatus @default(COMPLETED)
  createdAt      DateTime      @default(now())

  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  technician     User           @relation(fields: [technicianId], references: [id])
  usedSpareParts UsedSparePart[]
  attachments    Attachment[]
}

model SparePart {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  description   String?
  stockQuantity Int      @default(0)
  minimumStock  Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usedSpareParts UsedSparePart[]
}

model UsedSparePart {
  id              String   @id @default(cuid())
  serviceReportId String
  sparePartId     String
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())

  serviceReport ServiceReport @relation(fields: [serviceReportId], references: [id], onDelete: Cascade)
  sparePart     SparePart     @relation(fields: [sparePartId], references: [id])
}

model Attachment {
  id              String   @id @default(cuid())
  requestId       String?
  serviceReportId String?
  uploadedById    String
  fileName        String
  fileUrl         String
  fileType        String
  createdAt       DateTime @default(now())

  request       ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceReport ServiceReport? @relation(fields: [serviceReportId], references: [id], onDelete: Cascade)
  uploadedBy    User            @relation(fields: [uploadedById], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  requestId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  requestId String?
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
}
